{
  "name": "reactive-rpg",
  "version": "0.1.0",
  "private": true,
  "description": "Rules engine and test tools for the Reactive tabletop RPG system.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node scripts/check-node.js",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node dist/tests/rules_engine/run.js && node dist/tests/rules_engine/cases.js --log quiet",
    "cases": "npm run build --silent && node dist/tests/rules_engine/cases.js",
    "roll": "npm run build --silent && node dist/apps/dice_roller/src/main.js",
    "test:roll": "npm run build && node dist/tests/rules_engine/run.js roll && node dist/tests/rules_engine/cases.js --log quiet --suite roll",
    "test:result": "npm run build && node dist/tests/rules_engine/run.js result && node dist/tests/rules_engine/cases.js --log quiet --suite result",
    "build:web": "esbuild apps/dice_roller/web/main.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=apps/dice_roller/web/bundle.js",
    "test:parser": "node --test tests/character_sheet/parser-and-selection.test.mjs",
    "test:creation": "node --test tests/character_sheet/parser-and-selection.test.mjs tests/character_sheet/allocation.test.mjs tests/character_sheet/character-save.test.mjs",
    "test:character": "node --test tests/character_sheet/parser-and-selection.test.mjs tests/character_sheet/allocation.test.mjs tests/character_sheet/character-save.test.mjs",
    "test:all": "npm test && npm run test:creation",
    "validate:campaign": "node tests/character_sheet/validate-campaign.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "esbuild": "^0.25.0"
  }
}
